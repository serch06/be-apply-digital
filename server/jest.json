{
    "moduleFileExtensions": [
        "ts",
        "js",
        "json"
    ],
    "transform": {
        "^.+\\.ts$": "ts-jest"
    },
    "testRegex": ".*\\.(spec|test)\\.ts$",
    "collectCoverageFrom": [
        "src/**/*.{ts,js}",
        "!src/main.ts",
        "!**/node_modules/**",
        "!**/vendor/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
        "text",
        "json",
        "lcov"
    ],
    "testEnvironment": "node",
    "moduleNameMapper": {
        "^src/(.*)$": "<rootDir>/src/$1"
    }
}